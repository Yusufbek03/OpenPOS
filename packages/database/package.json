{
  "name": "@openpos/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "push": "prisma db push",
    "seed": "prisma db seed",
    "studio": "prisma studio",
    "reset": "prisma migrate reset"
  },
  "dependencies": {
    "@openpos/config": "workspace:*",
    "@openpos/shared": "workspace:*",
    "@prisma/client": "6.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "bcryptjs": "^2.4.3",
    "prisma": "6.2.0",
    "typescript": "5.7.3"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
